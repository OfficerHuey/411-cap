{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NursingSchedulerDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "TokenKey": "super-secret-key-that-is-long-enough-to-be-secure-at-least-64-bytes",
  "FileStorage": {
    "BasePath": "uploads/files",
    "MaxFileSizeMB": 50,
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".csv", ".png", ".jpg", ".jpeg", ".txt" ]
  }
}